# Copy to .env and fill in. Used by docker-compose.yml.

# Where the recipe library lives on the host. This is the NAS mount.
RECIPES_HOST_PATH=/volume1/recipes

# Port Caddy listens on.
HTTP_PORT=8080

# imgproxy URL signing. Both must be hex, and both must be set or the app
# falls back to serving original images itself.
#
#   openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=

# ---------------------------------------------------------------------------
# Read directly by the app; only needed when running it outside compose.
# ---------------------------------------------------------------------------

# RECIPE_PATH=./recipes
# COOK_CLI_PATH=cook
# COOK_CLI_TIMEOUT=30000

# How long the recipe index serves results before re-stat'ing the recipe
# directory. 0 in development so edits appear immediately.
# RECIPE_INDEX_TTL_MS=30000
